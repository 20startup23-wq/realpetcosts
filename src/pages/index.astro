  },
  rabbit:{
    standard:{firstYear:{food:200,vet:300,supplies:220,spayNeuter:250,toys:50,hay:200,misc:80},ongoing:{food:200,vet:250,supplies:40,spayNeuter:0,toys:50,hay:200,misc:80}}
  },
  bird:{
    standard:{firstYear:{food:150,vet:200,supplies:320,training:60,toys:80,misc:60},ongoing:{food:150,vet:150,supplies:60,training:0,toys:80,misc:60}}
  }
};
var LIFE={dog:{small:15,medium:12,large:10},cat:{small:16,medium:16,large:14},rabbit:{standard:10},bird:{standard:12}};
var INS={dog:{small:500,medium:800,large:1100},cat:{small:300,medium:350,large:450},rabbit:{standard:0},bird:{standard:0}};
var CLBLS={food:"Food and treats",vet:"Veterinary care",grooming:"Grooming",supplies:"Supplies",training:"Training",spayNeuter:"Spay and neuter",toys:"Toys and enrichment",boarding:"Boarding and sitting",litter:"Litter",hay:"Hay and bedding",misc:"Miscellaneous"};
var CICONS={food:"food",vet:"vet",grooming:"groom",supplies:"supply",training:"train",spayNeuter:"heart",toys:"toy",boarding:"home",litter:"litter",hay:"hay",misc:"misc"};

var DOG_SIZES=[{id:"small",l:"Small",s:"Under 25 lbs"},{id:"medium",l:"Medium",s:"25-60 lbs"},{id:"large",l:"Large",s:"Over 60 lbs"}];
var CAT_SIZES=[{id:"small",l:"Small",s:"Under 8 lbs"},{id:"medium",l:"Medium",s:"8-12 lbs"},{id:"large",l:"Large",s:"Over 12 lbs"}];

var pet=null, size="medium", view="firstYear", ins=false;

function fmt(n){return"$"+Math.round(n).toLocaleString();}
function fmtK(n){var v=Math.round(n/100)/10;return v>=10?"$"+Math.round(v)+"k":"$"+v.toFixed(1)+"k";}

function getVerdict(monthly,income){
  if(!income||income<=0)return null;
  var pct=Math.round((monthly/income)*100);
  if(pct<=5)return{msg:"This pet fits comfortably within your budget - "+pct+"% of your monthly income.",color:"#0F6E56",bg:"#E1F5EE"};
  if(pct<=10)return{msg:"This pet is manageable but will require some budgeting - "+pct+"% of your monthly income.",color:"#854F0B",bg:"#FDF0DC"};
  if(pct<=15)return{msg:"This pet will stretch your budget. Consider a smaller breed or a cat - "+pct+"% of your monthly income.",color:"#C4700A",bg:"#FEF3E2"};
  return{msg:"This pet may strain your finances. Build a 3-month emergency fund first - "+pct+"% of your monthly income.",color:"#A32D2D",bg:"#FCEBEB"};
}

function getSizeOptions(){
  if(pet==="dog")return DOG_SIZES;
  if(pet==="cat")return CAT_SIZES;
  return null;
}

function getVariant(){
  if(pet==="dog"||pet==="cat")return size;
  return "standard";
}

function renderPets(){
  var g=document.getElementById("pet-grid");
  g.innerHTML="";
  [{id:"dog",l:"Dog",e:"Dog"},{id:"cat",l:"Cat",e:"Cat"},{id:"rabbit",l:"Rabbit",e:"Rabbit"},{id:"bird",l:"Bird",e:"Bird"}].forEach(function(p){
    var b=document.createElement("button");
    b.className="pb"+(pet===p.id?" on":"");
    b.setAttribute("data-pet",p.id);
    b.innerHTML='<span class="lb">'+p.l+'</span>';
    b.addEventListener("click",function(){pet=this.getAttribute("data-pet");size="medium";ins=false;render();});
    g.appendChild(b);
  });
}

function renderSizes(){
  var sec=document.getElementById("size-section");
  var sizes=getSizeOptions();
  if(!sizes){sec.style.display="none";return;}
  sec.style.display="block";
  var lbl=document.getElementById("size-label");
  if(lbl)lbl.textContent=pet==="cat"?"Cat size":"Dog size";
  var g=document.getElementById("size-grid");
  g.innerHTML="";
  sizes.forEach(function(s){
    var b=document.createElement("button");
    b.className="sb"+(size===s.id?" on":"");
    b.setAttribute("data-size",s.id);
    b.innerHTML='<div class="sm">'+s.l+'</div><div class="ss">'+s.s+'</div>';
    b.addEventListener("click",function(){size=this.getAttribute("data-size");render();});
    g.appendChild(b);
  });
}

function renderIns(){
  var v=getVariant();
  var amt=pet?INS[pet][v]||0:0;
  var row=document.getElementById("ins-row");
  if(!pet||amt===0){row.style.display="none";return;}
  row.style.display="flex";
  document.getElementById("ins-label").textContent="Est. "+fmt(amt)+"/yr - accidents, illness, preventive care";
  var sw=document.getElementById("ins-toggle");
  sw.className="tsw"+(ins?" on":"");
  sw.querySelector(".tk").style.left=ins?"23px":"3px";
}

function renderResults(){
  if(!pet){document.getElementById("results").style.display="none";return;}
  document.getElementById("results").style.display="block";
  var v=getVariant();
  var data=COSTS[pet][v];
  if(!data)return;
  var insAmt=ins?(INS[pet][v]||0):0;
  var lifespan=LIFE[pet][v];
  var cats=data[view];
  var keys=Object.keys(cats);
  var base=0;for(var i=0;i<keys.length;i++)base+=cats[keys[i]];
  var total=base+insAmt;
  var fykeys=Object.keys(data.firstYear);
  var fy=0;for(var i=0;i<fykeys.length;i++)fy+=data.firstYear[fykeys[i]];
  if(ins)fy+=INS[pet][v];
  var ongkeys=Object.keys(data.ongoing);
  var ong=0;for(var i=0;i<ongkeys.length;i++)ong+=data.ongoing[ongkeys[i]];
  if(ins)ong+=INS[pet][v];
  var lifetime=fy+(ong*(lifespan-1));
  document.getElementById("c1l").textContent=view==="firstYear"?"First year total":"Annual cost";
  document.getElementById("c1v").textContent=fmt(total);
  document.getElementById("c2l").textContent="Lifetime ("+lifespan+" yrs)";
  document.getElementById("c2v").textContent=fmtK(lifetime);
  document.getElementById("monthly").textContent=fmt(total/12)+"/mo";
  var income=parseFloat(document.getElementById("income-input").value)||0;
  var verdict=getVerdict(total/12,income);
  var vbox=document.getElementById("verdict");
  if(verdict){vbox.style.display="block";vbox.style.background=verdict.bg;vbox.style.color=verdict.color;vbox.style.border="1px solid "+verdict.color;vbox.textContent=verdict.msg;}
  else{vbox.style.display="none";}
  var allkeys=Object.keys(cats);
  var entries=[];
  for(var i=0;i<allkeys.length;i++){if(cats[allkeys[i]]>0)entries.push([allkeys[i],cats[allkeys[i]]]);}
  entries.sort(function(a,b){return b[1]-a[1];});
  var maxV=insAmt;
  for(var i=0;i<entries.length;i++)if(entries[i][1]>maxV)maxV=entries[i][1];
  var bd=document.getElementById("breakdown");bd.innerHTML="";
  for(var i=0;i<entries.length;i++){
    var key=entries[i][0];var val=entries[i][1];
    var row=document.createElement("div");row.className="bkrow";
    if(i<entries.length-1)row.style.borderBottom="1px solid rgba(26,23,20,0.08)";
    var pct=Math.round((val/maxV)*100);
    row.innerHTML='<div class="bkr-top"><span class="bnm">'+(CLBLS[key]||key)+'</span><span class="bvl">'+fmt(val)+'</span></div><div class="bbg"><div class="bb" style="width:'+pct+'%"></div></div>';
    bd.appendChild(row);
  }
  if(ins&&insAmt>0){
    var row=document.createElement("div");row.className="bkrow ins";
    var pct=Math.round((insAmt/maxV)*100);
    row.innerHTML='<div class="bkr-top"><span class="bnm">Pet insurance</span><span class="bvl">'+fmt(insAmt)+'</span></div><div class="bbg"><div class="bb" style="width:'+pct+'%"></div></div>';
    bd.appendChild(row);
  }
}

function render(){renderPets();renderSizes();renderIns();renderResults();}

document.addEventListener("DOMContentLoaded",function(){
  document.getElementById("ins-toggle").addEventListener("click",function(){ins=!ins;render();});
  document.getElementById("tab-first").addEventListener("click",function(){view="firstYear";document.getElementById("tab-first").className="vt on";document.getElementById("tab-ongoing").className="vt";renderResults();});
  document.getElementById("tab-ongoing").addEventListener("click",function(){view="ongoing";document.getElementById("tab-first").className="vt";document.getElementById("tab-ongoing").className="vt on";renderResults();});
  document.getElementById("income-input").addEventListener("input",function(){renderResults();});
  render();
});
</script>
</body>
</html>