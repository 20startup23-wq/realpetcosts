.mobox .mv{font-family:'DM Serif Display',serif;font-size:20px;color:#FAC775}
.fine{font-size:11px;color:#857E77;line-height:1.6}
.ins-banner{background:#E1F5EE;border:1px solid rgba(15,110,86,0.25);border-radius:12px;padding:16px 18px;margin-bottom:16px}
.ins-banner h4{font-size:14px;font-weight:600;color:#0F6E56;margin-bottom:4px}
.ins-banner p{font-size:13px;color:#085041;line-height:1.5}
.section-card{background:#fff;border-radius:16px;border:1px solid rgba(26,23,20,0.1);padding:24px;margin-bottom:20px}
.section-card h2{font-family:'DM Serif Display',serif;font-size:20px;margin-bottom:14px}
.health-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px}
@media(max-width:600px){.health-grid{grid-template-columns:1fr}}
.health-item{background:#FAF7F2;border-radius:10px;padding:14px;border:1px solid rgba(26,23,20,0.08)}
