.vt{flex:1;padding:7px 0;border-radius:8px;border:none;cursor:pointer;font-size:13px;font-weight:500;font-family:inherit;background:transparent;color:#857E77;transition:all 0.15s}
.vt.on{background:#fff;color:#1A1714;box-shadow:0 1px 4px rgba(0,0,0,0.08)}
