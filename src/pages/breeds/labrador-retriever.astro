.alink{display:flex;align-items:center;justify-content:space-between;padding:9px 11px;border-radius:8px;background:#FAF7F2;border:1px solid rgba(26,23,20,0.1);text-decoration:none;color:#1A1714;font-size:13px;font-weight:500;margin-bottom:7px;transition:all 0.15s}
