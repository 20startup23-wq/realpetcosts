<style is:global>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:'DM Sans',sans-serif;background:#FAF7F2;color:#1A1714;line-height:1.6}
nav{background:#1A1714;padding:14px 24px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:100}
.logo{font-family:'DM Serif Display',serif;font-size:18px;color:#fff;text-decoration:none}
.logo span{color:#FAC775}
