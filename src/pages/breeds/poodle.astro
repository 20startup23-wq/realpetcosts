footer{background:#1A1714;color:rgba(255,255,255,0.45);text-align:center;padding:28px 24px}
footer .fl{font-family:'DM Serif Display',serif;font-size:15px;color:#FAC775;margin-bottom:6px}
footer p{font-size:12px}
