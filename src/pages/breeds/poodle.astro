nav ul a:hover{color:#fff}
.hero{background:#1A1714;padding:48px 24px 40px;text-align:center}
.badge{display:inline-block;background:#C4700A;color:#fff;font-size:11px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;padding:5px 14px;border-radius:100px;margin-bottom:16px}
.hero h1{font-family:'DM Serif Display',serif;font-size:clamp(26px,5vw,44px);color:#fff;line-height:1.15;max-width:680px;margin:0 auto 12px;letter-spacing:-0.5px}
.hero h1 em{color:#FAC775;font-style:italic}
