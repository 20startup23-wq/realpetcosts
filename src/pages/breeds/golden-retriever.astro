<script is:inline>
var firstYear = [
  {name:"Purchase price (avg)", cost:2500},
  {name:"Veterinary care", cost:600},
  {name:"Pet insurance", cost:900},
  {name:"Food and treats", cost:600},
  {name:"Spay / neuter", cost:400},
  {name:"Supplies and setup", cost:350},
  {name:"Grooming", cost:600},
  {name:"Training", cost:300},
  {name:"Boarding / sitting", cost:500},
  {name:"Misc", cost:150}
];
var ongoing = [
  {name:"Veterinary care", cost:550},
  {name:"Pet insurance", cost:900},
  {name:"Food and treats", cost:600},
  {name:"Grooming", cost:600},
  {name:"Boarding / sitting", cost:500},
  {name:"Supplies", cost:100},
  {name:"Misc", cost:150}
];
var view = "firstYear";

function fmt(n){return "$"+Math.round(n).toLocaleString();}
function fmtK(n){var v=Math.round(n/100)/10;return v>=10?"$"+Math.round(v)+"k":"$"+v.toFixed(1)+"k";}

function renderCalc(){
  var data = view === "firstYear" ? firstYear : ongoing;
  var total = 0;
  for(var i=0;i<data.length;i++) total += data[i].cost;
  var fyTotal = 0;
  for(var i=0;i<firstYear.length;i++) fyTotal += firstYear[i].cost;
  var ongTotal = 0;
  for(var i=0;i<ongoing.length;i++) ongTotal += ongoing[i].cost;
  var lifeTotal = fyTotal + (ongTotal * 10);

  document.getElementById("c1l").textContent = view === "firstYear" ? "First year total" : "Annual cost";
  document.getElementById("c1v").textContent = fmt(total);
  document.getElementById("c2v").textContent = fmtK(lifeTotal);
  document.getElementById("monthly").textContent = fmt(total/12)+"/mo";

  var bd = document.getElementById("breakdown");
  bd.innerHTML = "";
  for(var i=0;i<data.length;i++){
    var row = document.createElement("div");
    row.className = "bkrow";
    row.innerHTML = '<span class="bnm">'+data[i].name+'</span><span class="bvl">'+fmt(data[i].cost)+'</span>';
    bd.appendChild(row);
  }
}

document.addEventListener("DOMContentLoaded", function(){
  document.getElementById("tab-first").addEventListener("click", function(){
    view = "firstYear";
    document.getElementById("tab-first").className = "vt on";
    document.getElementById("tab-ongoing").className = "vt";
    renderCalc();
  });
  document.getElementById("tab-ongoing").addEventListener("click", function(){
    view = "ongoing";
    document.getElementById("tab-first").className = "vt";
    document.getElementById("tab-ongoing").className = "vt on";
    renderCalc();
  });
  renderCalc();
});
</script>
</body>
</html>